# Server Configuration
PORT=8090
 
# LLM Configuration (Example for OpenAI)
# Replace with your actual key and potentially organization ID
OPENAI_API_KEY="Your OpenAI API Key"
 
# CORS Configuration (Optional - '*' is permissive, restrict in production)
CORS_ORIGIN=*
# CORS_ORIGIN=https://your-cursor-or-agent-origin.com,http://localhost:xxxx
 
# SSE Configuration
# Timeout for inactive connections in milliseconds (default: 15 minutes)
SSE_IDLE_TIMEOUT=900000
# Heartbeat interval in milliseconds (default: 30 seconds)
SSE_HEARTBEAT_INTERVAL=30000
# Maximum message retry attempts (default: 3)
SSE_MAX_RETRY_ATTEMPTS=3

# Debug Settings
# Set to 'true' to enable detailed SSE debugging
DEBUG_SSE=false

# Other secrets or configurations if needed